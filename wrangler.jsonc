{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "unicef-club-130",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-11-04",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  // esbuild's keep_names injects `__name()` into functions; next-themes serializes its theme
  // script with Function#toString, which then throws "__name is not defined" in the browser.
  "keep_names": false,
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
  },
  "observability": {
    "enabled": true,
  },
  // Self-reference service binding required by the OpenNext caching layer.
  // The service name must match "name" above. See https://opennext.js.org/cloudflare/caching
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "unicef-club-130",
    },
  ],
  // Production resources (APAC). Local dev/preview uses Miniflare emulation (.wrangler/state).
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "unicef-club-130-db",
      "database_id": "7f1e5d21-0b3e-4518-93ba-cc30194263ea",
      "migrations_dir": "drizzle/migrations",
    },
  ],
  "r2_buckets": [
    {
      // Uploaded images (news covers, gallery, member photos)
      "binding": "MEDIA",
      "bucket_name": "unicef-club-130-media",
    },
    {
      // OpenNext incremental cache (ISR / fetch cache)
      "binding": "NEXT_INC_CACHE_R2_BUCKET",
      "bucket_name": "unicef-club-130-opennext-cache",
    },
  ],
  // Non-secret production settings. Locally, .dev.vars overrides these (see .dev.vars.example).
  // Secrets (BETTER_AUTH_SECRET, TURNSTILE_SECRET_KEY, GOOGLE_*) are set with `wrangler secret put`.
  "vars": {
    "SITE_URL": "https://unicef-club-130.erkhes-labs.workers.dev",
    "BETTER_AUTH_URL": "https://unicef-club-130.erkhes-labs.workers.dev",
    "BETTER_AUTH_TRUSTED_ORIGINS": "https://unicef-club-130.erkhes-labs.workers.dev",
    // Public Turnstile site key (not a secret). TODO(deploy): set after creating the widget.
    "TURNSTILE_SITE_KEY": "",
    "GOOGLE_SHEET_TAB": "Applications",
  },
  // Custom domain later: add it in the dashboard, or uncomment and redeploy (see README).
  // "routes": [{ "pattern": "unicef130.example.mn", "custom_domain": true }],
}
