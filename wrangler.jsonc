{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "unicef-club-130",
  // worker.ts wraps the OpenNext app (.open-next/worker.js) and adds the daily cron job.
  "main": "worker.ts",
  "compatibility_date": "2026-11-04",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  // esbuild's keep_names injects `__name()` into functions; next-themes serializes its theme
  // script with Function#toString, which then throws "__name is not defined" in the browser.
  "keep_names": false,
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
  },
  // Daily at 03:30 Ulaanbaatar time: delete expired rejected applications (privacy).
  "triggers": { "crons": ["30 19 * * *"] },
  "observability": {
    "enabled": true,
  },
  // Self-reference service binding required by the OpenNext caching layer.
  // The service name must match "name" above. See https://opennext.js.org/cloudflare/caching
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "unicef-club-130",
    },
  ],
  // The deployment's version id: part of the data-centre page-copy key (src/lib/edge-cache.ts),
  // so a copy made by the previous deploy (pointing at its /_next/static files) is never served.
  "version_metadata": {
    "binding": "CF_VERSION_METADATA",
  },
  // Production resources (APAC). Local dev/preview uses Miniflare emulation (.wrangler/state).
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "unicef-club-130-db",
      "database_id": "7f1e5d21-0b3e-4518-93ba-cc30194263ea",
      "migrations_dir": "drizzle/migrations",
    },
    {
      // OpenNext tag cache (table `revalidations`, migration 0010): the SAME database as DB,
      // so no extra resource is needed on the Free plan.
      "binding": "NEXT_TAG_CACHE_D1",
      "database_name": "unicef-club-130-db",
      "database_id": "7f1e5d21-0b3e-4518-93ba-cc30194263ea",
      "migrations_dir": "drizzle/migrations",
    },
  ],
  // Background re-rendering of cached pages (OpenNext DO queue, SQLite-backed: Free plan).
  "durable_objects": {
    "bindings": [{ "name": "NEXT_CACHE_DO_QUEUE", "class_name": "DOQueueHandler" }],
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["DOQueueHandler"] }],
  "r2_buckets": [
    {
      // Uploaded images (news covers, gallery, member photos)
      "binding": "MEDIA",
      "bucket_name": "unicef-club-130-media",
    },
    {
      // OpenNext incremental cache (ISR / fetch cache)
      "binding": "NEXT_INC_CACHE_R2_BUCKET",
      "bucket_name": "unicef-club-130-opennext-cache",
    },
  ],
  // Non-secret production settings. Locally, .dev.vars overrides these (see .dev.vars.example).
  // Secrets (CLERK_SECRET_KEY, CLERK_WEBHOOK_SIGNING_SECRET, GOOGLE_*, CF_*) are
  // set with `wrangler secret put`. NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY (public) is added here for
  // the Clerk production instance (see DEPLOY_CHECKLIST).
  "vars": {
    "SITE_URL": "https://130foreverychild.site",
    // Clerk production instance (public value, not a secret).
    "NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY": "pk_live_Y2xlcmsuMTMwZm9yZXZlcnljaGlsZC5zaXRlJA",
    "GOOGLE_SHEET_TAB": "Applications",
    // Background re-renders of stale pages one at a time (default 5): each costs 40–280 ms of
    // CPU on the Free plan, so several at once in one isolate risk Error 1102 for visitors too.
    "NEXT_CACHE_DO_QUEUE_MAX_REVALIDATION": "1",
  },
  // Custom domain: created/attached by `wrangler deploy` (DNS record managed by Cloudflare).
  "routes": [{ "pattern": "130foreverychild.site", "custom_domain": true }],
  // Local `wrangler dev` / preview would otherwise rewrite request URLs to the route's host above,
  // and Clerk's dev handshake would then send the browser to the live site.
  "dev": { "host": "localhost:8787", "upstream_protocol": "http" },
}
