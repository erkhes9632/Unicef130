{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "entry": [
    "open-next.config.ts",
    "scripts/*.ts",
    "scripts/report/{parse-docx,build-import,run-import}.ts",
    "e2e/**/*.ts",
    "tests/**/*.test.ts"
  ],
  "project": ["src/**/*.{ts,tsx}", "scripts/**/*.ts", "e2e/**/*.ts", "tests/**/*.ts", "*.ts"],
  "ignoreDependencies": [
    "@tailwindcss/turbopack",
    "tailwindcss",
    "tw-animate-css",
    "shadcn",
    "cloudflare"
  ],
  "ignoreExportsUsedInFile": true,
  "rules": {
    "types": "warn"
  },
  "includeEntryExports": false
}
