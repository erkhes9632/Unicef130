# Copy to .dev.vars (gitignored) for local development:  cp .dev.vars.example .dev.vars
# Production secrets: bunx wrangler secret put <NAME>   (see README.md)
NEXTJS_ENV=development

# Clerk (sign-in) — Development instance keys: Clerk dashboard → API keys.
# The publishable key is public; the secret key must stay out of git and chat.
# Required locally: wrangler.jsonc holds the PRODUCTION key (pk_live_); these lines override it so
# local dev, preview and e2e never touch the production instance.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
# Webhook signing secret (Clerk dashboard → Webhooks → endpoint). Optional locally: without it
# the site still mirrors users on their first signed-in request.
# CLERK_WEBHOOK_SIGNING_SECRET=whsec_...

# Local overrides of the production "vars" in wrangler.jsonc. Keep them empty locally:
# empty SITE_URL = inferred from the request, empty TURNSTILE_SITE_KEY = test key.
SITE_URL=
TURNSTILE_SITE_KEY=

# Cloudflare Turnstile (optional locally). Empty → Cloudflare test keys (always pass).
# TURNSTILE_SECRET_KEY=

# Google Sheets sync for join applications (optional). Empty → sync skipped silently.
# Private key: paste the "private_key" value from the service-account JSON (keep the \n escapes).
# GOOGLE_SERVICE_ACCOUNT_EMAIL=club-sheets@your-project.iam.gserviceaccount.com
# GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# GOOGLE_SHEET_ID=1AbC...   (from the sheet URL: /spreadsheets/d/<ID>/edit)
# GOOGLE_SHEET_TAB=Applications

