# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# logs, screenshots and scratch output (audits and SQL dumps belong in private/)
*.log
/*.png
/*.jpg
/*.webp
/screenshots/
/tmp/
/*.sql
*.tmp.sql

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# OpenNext
.open-next

# wrangler files
.wrangler
.dev.vars*
!.dev.vars.example

# local working notes and task prompts (kept locally, not published)
PROGRESS.md
PROGRESS.archive.md
UI_DIRECTION.md
*_PROMPT.md

# private club data (member names, hours) and generated production seed SQL
private/

# Playwright
/test-results/
/playwright-report/
